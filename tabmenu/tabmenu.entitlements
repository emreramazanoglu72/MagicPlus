<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Hardened Runtime denies these outright unless they are declared, without ever showing
	  a permission prompt. Each one backs a specific feature:
	  - apple-events: asking Music and Spotify what is playing
	  - camera: the Mirror tab in the notch panel
	  - calendars: the Agenda tab and the meeting countdown
	-->
	<!-- audio-input: hardened runtime gate for the mixer's process taps -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
