{
  "sourceLanguage": "en",
  "strings": {
    "\nChecks for updates once a day.": {
      "comment": "About panel: automatic update checks are on",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nGünde bir kez güncelleme denetler."
          }
        }
      }
    },
    "—": {
      "shouldTranslate": false
    },
    "·": {
      "shouldTranslate": false
    },
    "· click again to cycle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "· döngü için tekrar tıkla"
          }
        }
      }
    },
