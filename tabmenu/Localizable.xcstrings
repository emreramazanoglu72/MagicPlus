    "Accessibility is what lets this read window titles.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere başlıklarını okumayı sağlayan şey Erişilebilirlik iznidir."
