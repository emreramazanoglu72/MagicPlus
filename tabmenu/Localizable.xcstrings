          }
        }
      }
    },
    "Allow Calendar access to see your next meeting": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki toplantını görmek için Takvim erişimine izin ver"
          }
        }
      }
    },
    "Allow it and your next meetings appear here, with a button to join them.": {
      "comment": "Agenda pane, empty state",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verdiğinizde yaklaşan toplantılarınız, katılma düğmesiyle birlikte burada görünür."
          }
        }
      }
    },
    "Allow MagicPlus under Privacy & Security → Automation, then switch the setting off and on again.": {
      "comment": "How to recover from a denied Automation permission",
      "localizations": {
